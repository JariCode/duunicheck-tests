# --- Addresses --------------------------------------------------------------
# Frontend (Vite dev server), with trailing slash
FRONTEND_URL=http://localhost:5173/
# Backend root without trailing slash
API_URL=http://localhost:5000
# Exact value of ALLOWED_ORIGIN in the TEST backend (used by the CORS tests)
ALLOWED_ORIGIN=http://localhost:5173

# --- Test users (create both in the Clerk DEVELOPMENT dashboard) ------------
# Emails must contain +clerk_test so Clerk accepts the fixed code 424242 and sends no real mail
TEST_USER_A_EMAIL=robot.a+clerk_test@example.com
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=robot.b+clerk_test@example.com
TEST_USER_B_PASSWORD=
TEST_CLERK_CODE=424242

# --- Optional ---------------------------------------------------------------
# Clerk development secret key (sk_test_...). Only TC02-016 (token without azp) needs it.
CLERK_SECRET_KEY=
# Same value as CLERK_WEBHOOK_SIGNING_SECRET in the test backend (enables the signed webhook tests)
CLERK_WEBHOOK_SIGNING_SECRET=
# true when the test backend has OPENAI_API_KEY set (a dummy value is enough, the tests never reach OpenAI)
BACKEND_HAS_OPENAI_KEY=false
# true to run one real OpenAI call (costs a little money)
RUN_REAL_AI=false
# true to run slow limit tests (creating 25 CVs and similar)
RUN_SLOW=false
# Path of the DuuniCheck application repository (the .htaccess and build tests read it).
APP_DIR=C:\path\to\DuuniCheck

# Backend API rate limit per 15 min (120 unless you raised it in the test backend)
API_RATE_LIMIT=120
# true: when the API answers 429 the tests wait for the window to reset instead of failing
AUTO_WAIT_RATE_LIMIT=true

# --- Browser ----------------------------------------------------------------
# chromium, firefox or webkit (lower case)
BROWSER=chromium
# false shows the browser window while the tests run, true hides it
HEADLESS=false
# Slow-down in seconds between browser actions
SLOWMO=0.5
